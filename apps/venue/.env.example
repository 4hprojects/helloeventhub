# Venue check-in server (runs on the main committee laptop at the venue).
VENUE_PORT=8080
VENUE_HOST=0.0.0.0
VENUE_DATA_DIR=./data
VENUE_BACKUP_DIR=./backups
# Cloud connection — get the device token from Admin > Venue (shown once).
CLOUD_BASE_URL=https://helloeventhub.online
CLOUD_EVENT_ID=
CLOUD_DEVICE_TOKEN=
SYNC_INTERVAL_MS=30000
BACKUP_INTERVAL_MS=600000
# Optional HTTPS for the LAN (needed only for camera/QR, not for manual check-in)
VENUE_TLS_CERT=
VENUE_TLS_KEY=
