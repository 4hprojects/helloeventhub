# ---------------------------------------------------------------------------
# HelloEventHub environment template. Copy to .env for local dev.
# NEVER commit real values. In production set these in HelloDeploy's secret store.
# All variables are SERVER-SIDE ONLY. The browser receives only the values exposed
# by GET /api/v1/public-config (Turnstile site key, app name).
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:5173
# Comma-separated list of allowed browser origins (same-origin is always allowed)
ALLOWED_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the app (HelloDeploy nginx = 1)
TRUST_PROXY=1
# Production behind Cloudflare (orange cloud): true. Local dev: false.
CLOUDFLARE=false
EVENT_TIMEZONE=Asia/Manila

# MongoDB (Atlas in staging/production). Must be a replica set (Atlas always is).
MONGODB_URI=mongodb://localhost:27017/helloeventhub?replicaSet=rs0&directConnection=true

# >= 32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=dev-only-change-me-dev-only-change-me-0000

# Email (Resend). Leave RESEND_API_KEY empty in dev to use the console transport.
RESEND_API_KEY=
EMAIL_FROM="HelloEventHub <noreply@helloeventhub.online>"
EMAIL_REPLY_TO=
# Run the email worker inside the web process (true for single-instance deploys)
EMAIL_WORKER_ENABLED=true

# Cloudflare Turnstile. These are Cloudflare's public always-pass TEST keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Accept submissions (flagged + stricter rate limit) if Cloudflare is unreachable
TURNSTILE_FAIL_OPEN=true
# Dev/test only: skip the Turnstile widget entirely. Refused when NODE_ENV=production.
TURNSTILE_DISABLED=false

LOG_LEVEL=info

# Event linked from the landing page and privacy page
PRIMARY_EVENT_SLUG=mb-wa-reunion-2026
